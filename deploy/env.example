# Copy to `.env` next to docker-compose.yml and fill in.  cp env.example .env

# Bearer token the app sends. Generate:  openssl rand -base64 24
READER_TOKEN=

# Domain pointed at this instance's public IP (for the HTTPS compose file).
# Leave unused if you deploy the IP-only variant.
READER_DOMAIN=reader.example.com

# Optional — Claude Haiku auto-tagging
ANTHROPIC_API_KEY=
TAG_LLM_ENABLED=false

# Optional — Reddit OAuth (anonymous Reddit is blocked; register a "script" app
# at https://www.reddit.com/prefs/apps for 100 queries/min, free for personal use)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=reader-personal/0.1 (by /u/yourname)

# Descriptive UA for feed/article fetches
HTTP_USER_AGENT=reader-personal/0.1 (+https://github.com/yourname/reader)
LOG_LEVEL=info
