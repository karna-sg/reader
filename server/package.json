{
  "name": "reader-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal knowledge-aggregator backend: fetch RSS/Atom + free JSON APIs, dedup, auto-tag, rank, serve JSON to the iOS Reader app.",
  "bin": {
    "reader": "./dist/entry.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/entry.ts",
    "serve": "tsx src/entry.ts serve",
    "poll": "tsx src/entry.ts poll",
    "probe": "tsx src/entry.ts probe",
    "start": "node dist/entry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@hono/node-server": "2.1.1",
    "@mozilla/readability": "0.6.0",
    "commander": "15.0.0",
    "croner": "10.0.1",
    "dotenv": "17.4.2",
    "feedsmith": "2.9.6",
    "hono": "4.13.2",
    "kysely": "0.29.5",
    "linkedom": "0.18.13",
    "tslog": "4.10.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxlint": "1.78.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
