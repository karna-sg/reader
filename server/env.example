# Reader server configuration TEMPLATE.
# Copy to `.env` (which is gitignored) and fill in:  cp env.example .env
# NEVER commit the real .env.

# HTTP
PORT=8787
# Single-user bearer token the iOS app sends as `Authorization: Bearer <token>`.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
READER_TOKEN=

# SQLite database file (created on first run).
DB_PATH=./data/reader.db

# Claude Haiku auto-tagging (Phase 3). Leave TAG_LLM_ENABLED=false to run rules-only (no LLM calls).
ANTHROPIC_API_KEY=
TAG_MODEL=claude-haiku-4-5
TAG_LLM_ENABLED=false

# Reddit (Phase 2). Anonymous .rss is throttled to ~1 req/min since mid-2025 — prefer OAuth.
# Register a "script" app at https://www.reddit.com/prefs/apps for 100 qpm free (personal use).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=reader-personal/0.1 (by /u/yourname)

# Fetching
DEFAULT_POLL_INTERVAL_MS=900000
HTTP_USER_AGENT=reader-personal/0.1 (+https://github.com/personal/reader)

# Logging: silly | trace | debug | info | warn | error | fatal
LOG_LEVEL=info
